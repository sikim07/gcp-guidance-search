# --- Required in production ---
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# Supabase. If omitted, the app uses a local JSON store under .data/
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Vercel Cron
CRON_SECRET=change-me

# Admin logs page: /admin?key=...
ADMIN_SECRET=change-me

# Rate limits for POST /api/search
RATE_LIMIT_IP_DAILY=20
RATE_LIMIT_GLOBAL_DAILY=200

# Optional alerts when revisions are detected
SLACK_WEBHOOK_URL=
ALERT_EMAIL=

# Claude Code Stop hook (0-1). Skip review locally if unset.
STOP_REVIEW_PROVIDER=gemini
GEMINI_API_KEY=
STOP_REVIEW_OPENAI_KEY=
STOP_REVIEW_MODEL=

# Ingest only the v1 priority corpus (recommended)
PRIORITY_ONLY=true

# Replay HTML fixtures instead of live HTTP (tests / offline)
USE_FIXTURE_SOURCES=false
