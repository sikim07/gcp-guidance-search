# --- Required in production ---
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# Supabase. If omitted, the app uses a local JSON store under .data/
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Vercel Cron
CRON_SECRET=change-me

# Admin logs page: /admin?key=...
ADMIN_SECRET=change-me

# Rate limits for POST /api/search
RATE_LIMIT_IP_DAILY=5
RATE_LIMIT_GLOBAL_DAILY=50

# Optional alerts when revisions are detected
SLACK_WEBHOOK_URL=
ALERT_EMAIL=

# Ingest only the v1 priority corpus (recommended)
PRIORITY_ONLY=true

# Replay HTML fixtures instead of live HTTP (tests / offline)
USE_FIXTURE_SOURCES=false

# Optional. Google Apps Script web app URL. Feedback rows go to a Sheet.
# See scripts/feedback-sheet.gs
FEEDBACK_SHEETS_WEBHOOK_URL=

# Public site URL for sitemap / Open Graph
NEXT_PUBLIC_SITE_URL=https://gcp-guidance-search.vercel.app

# Google AdSense Auto ads: publisher ID + head script live in code (lib/ads.ts,
# app/layout.tsx, public/ads.txt). No manual slot env vars.

# Google Analytics 4 measurement ID (G-…). Omit to disable the notice, gtag, and events.
# Set on Vercel (Production + Preview) after creating a GA4 property; do not hardcode in source.
NEXT_PUBLIC_GA_MEASUREMENT_ID=
